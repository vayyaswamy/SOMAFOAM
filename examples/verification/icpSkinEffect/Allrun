#!/bin/sh
# Inductive field of a uniform plasma cylinder in a long solenoid (paper case
# V5): the vector potential of the ICP field solve of somaFoam against the
# exact Bessel solution, on three meshes (verify.py).
cd ${0%/*} || exit 1    # run from this directory

# radial cells and wedge angle [deg]; with these numbers of cells the edges of
# the plasma and of the winding are faces. The 5 degree run shows the error of a
# flat-faced wedge, of the order of the square of the angle
set -- 160 1  320 1  640 1  640 5
while [ $# -ge 2 ]
do
    nr=$1; ang=$2; shift 2
    dir=runs/nr_${nr}_wedge_$ang
    rm -rf $dir
    mkdir -p runs
    cp -r base $dir
    python3 makeCase.py $dir $nr $ang || exit 1
    ( cd $dir && blockMesh > log.blockMesh 2>&1 && icpFieldTest > log.icpFieldTest 2>&1 ) || exit 1
done

python3 verify.py runs
