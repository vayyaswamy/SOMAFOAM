FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      AR;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    axis        { type fixedValue; value uniform 0; }
    wall        { type fixedValue; value uniform 0; }
    ends        { type zeroGradient; }
    front       { type wedge; }
    back        { type wedge; }
}
