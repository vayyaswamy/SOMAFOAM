#!/bin/sh
# Electron avalanche in a uniform field (paper case V12): a Gaussian pulse of
# electrons with constant mobility, diffusion and ionization frequency, at a
# density far below that at which its space charge would change the field;
# its growth, drift and spreading against the exact solution at two time
# steps (verify.py).
cd ${0%/*} || exit 1    # run from this directory

for dt in 1e-10 2.5e-11
do
    dir=runs/dt_$dt
    rm -rf $dir
    mkdir -p runs
    cp -r base $dir
    sed -i "s/^deltaT\s.*/deltaT          $dt;/; s/^deltaTMax.*/deltaTMax       $dt;/; s/^deltaTMin.*/deltaTMin       $dt;/" $dir/system/controlDict
    ( cd $dir && blockMesh > log.blockMesh 2>&1 && setExpressionFields > log.setExpressionFields 2>&1 \
      && somaFoam > log.somaFoam 2>&1 ) || exit 1
done

python3 verify.py runs
