FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      reactions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

species
(
	electron
	Arp1
	Arm
	Ar
);

reactions
(
    // ionization at a constant frequency nu = k N of about 1e7 1/s: the rate
    // coefficient A Te^0 exp(0/Te) is given per kmol, k = A/6.02214076e26 m3/s
        electronImpactInelasticArrheniusReaction
		electron + Ar = electron + electron + Arp1
        (1.870915e11 0 0)
        (2.5248E-18)
);
