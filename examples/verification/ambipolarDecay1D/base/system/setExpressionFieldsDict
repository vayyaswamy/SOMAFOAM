FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExpressionFieldsDict;
}

// Quasi-neutral plasma in the fundamental diffusion mode of the 2 cm gap
variables
{
    n0          1e17;       // [1/m3]
    L           0.02;       // [m]
    mode        "1e4 + n0*sin(3.14159265358979*x/L)";
}

fields
{
    electron    "mode";
    Arp1        "mode";
}
