FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      reactions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

species
(
	electron
	Arp1
	Arm
	Ar
);

reactions
(
    // Elastic collisions, ionization and excitation of the ground state, with
    // the Maxwellian rate coefficients of the global model of Lieberman and
    // Lichtenberg (makeRates.py writes the tables); the excitation is an
    // energy loss only (no metastables), so that the ground-state density
    // stays at the gas density
        electronImpactElasticTabularReaction
        electron + Ar = electron + Ar
        ("$FOAM_CASE/constant/reaction_el")

        electronImpactInelasticTabularReaction
        electron + Ar = electron + electron + Arp1
        ("$FOAM_CASE/constant/reaction_iz")
        (2.5248E-18)

        electronImpactInelasticTabularReaction
        electron + Ar = electron + Ar
        ("$FOAM_CASE/constant/reaction_ex")
        (1.851912e-18)
);
