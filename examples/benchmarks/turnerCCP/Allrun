#!/bin/sh
# Turner et al. (2013) helium CCP benchmark, cases 1 to 4 (paper case B4):
# mid-plane ion density, electron temperature and ion current against the
# particle-in-cell results of the benchmark, and the ion density profile of
# case 1 (compare.py). Each case runs for the simulation time of the
# benchmark, from 1280 to 15360 periods; SOMAFOAM_TEST_SHORT=1 runs 64.
# Run one case with ./Allrun <case>.
cd ${0%/*} || exit 1    # run from this directory

cases=${*:-1 2 3 4}
for c in $cases
do
    dir=runs/case$c
    rm -rf $dir
    mkdir -p runs
    mkdir $dir
    cp -r ../../plasma/HeliumIonDistribution/0 ../../plasma/HeliumIonDistribution/constant \
          ../../plasma/HeliumIonDistribution/system $dir/
    python3 makeCase.py $dir $c ${SOMAFOAM_TEST_SHORT:+64} || exit 1
    ( cd $dir && blockMesh > log.blockMesh 2>&1 && setExpressionFields > log.setExpressionFields 2>&1 \
      && somaFoam > log.somaFoam 2>&1 ) || exit 1
done

python3 compare.py runs
