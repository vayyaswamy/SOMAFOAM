FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    rho
    {
        solver          diagonal;
    }

    rhoFinal
    {
        solver          diagonal;
    }

    "(U|hs|p)Final"
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }

    U
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }

    hs
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }

    p
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }

    Ni
    {
        solver          BiCGStab;
        preconditioner  DILU;
        relTol           0.0;
        minIter          1;
    }

    Nin
    {
        solver          BiCGStab;
        preconditioner  DILU;
        relTol           0.0;
        minIter          1;
    }

    Te
    {
        solver          BiCGStab;
        preconditioner  DILU;
        relTol           0.0;
        minIter          1;
    };

    Phi
    {
        solver           BiCGStab;
        preconditioner   Cholesky;
        relTol           0;
        minIter		 1;
    };
}

flowPIMPLE
{
    nOuterCorrectors 2;
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
    momentumPredictor yes;
    pMin            pMin [1 -1 -2 0 0] 1;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       133.3224;
    rhoMin          rhoMin [1 -3 0 0 0] 1e-4;
    rhoMax          rhoMax [1 -3 0 0 0] 10;
}

PIMPLE
{
    momentumPredictor no;
    nOuterCorrectors 1; // used by pimple.loop()
    nCorrectors    1; // used by pimple.correct()
    nNonOrthogonalCorrectors 0; // used by pimple.correct()


    residualControl
    {
        Phi
        {
                tolerance  1e-5;
                relTol      0;
        }
    N_electron
    {
        tolerance 1e-4;
        relTol  0;

    }
    N_Arp1
    {
        tolerance 1e-4;
        relTol  0;

    }
    //N_Arm
    //{
     //   tolerance 1e-4;
      //  relTol  0;

    //}
    Te
    {
        tolerance 1e-4 ;
        relTol 0;
    }
     }
    
}

relaxationFactors
{
    fields
    {
        p               0.3;
        rho             1;
	".*"	0.8;
    ".*Final" 1.0;
    }
    equations
    {
        UFinal          1;
        hsFinal         1;
        U               0.7;
        hs              0.7;
		”.*”           1; 
    }
}

