FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Used by plasmaMultiRegionFoam
    Phi
    {
        solver           PCG;
        preconditioner   Cholesky;
        tolerance        1e-14;
        relTol           0;
        minIter          1;
    };
}

relaxationFactors
{
}

