FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// electronBoltzmann needs a case with system/controlDict (no mesh); the
// time settings are not used.
application     electronBoltzmann;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1;
deltaT          1;
writeControl    timeStep;
writeInterval   1;
writePrecision  10;                         // digits of transport.dat

