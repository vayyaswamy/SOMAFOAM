FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs (
      "libfoam.so"
      "liblduSolvers.so"
      "libplasmaCookBook.so"
     );

application     somaFoam;

startFrom       startTime;

startTime       0;

endTime         4.4247787611e-04;    // 6000 periods

stopAt          endTime;

deltaT     2.9498525074e-10;

MaxCo           10.0;

deltaTMax     2.9498525074e-10;

deltaTMin     2.9498525074e-10;

writeControl    timeStep;

writeInterval   62500;               // 250 periods of 250 steps

purgeWrite      0;

writeFormat     ascii;

writePrecision  15;

writeCompression uncompressed;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

restartCapable on;

OptimisationSwitches
{
    commsType       nonBlocking;
}

DebugSwitches
{
    dimensionSet    0;
	solution  0;
    lduMatrix 0;
    blockLduMatrix 0;
}

Tolerances
{
    // Primitive mesh checking limits
    primitiveMeshClosedThreshold     1e-8;
    // Geometric matching tolerances
    patchFaceMatchTol   1e-8;
    // Intersection tolerance
    intersectionPlanarTol      0.2;
    intersectionMissTol        1e-10;
    GGIAreaErrorTol                 1e-8;
}


functions
{

    // Voltage and current of the electrodes versus time, written to
    // electrodes/<start time>/<patch>.dat
    electrodes
    {
        type                electrodeVoltageCurrent;
        functionObjectLibs  ("libplasmaFunctionObjects.so");
        patches             (electrode ground);
    }


	dumpObjects
	{
		type            writeRegisteredObject;
		functionObjectLibs ("libIOFunctionObjects.so");
		outputControl   outputTime;
		objectNames    ("E" "Sy_electron" "J_electron" "J_Hep1");
	}

//	boundTemperature
//	{
//		type boundField;
//		functionObjectLibs ("libsampling.so");
//		name Te;
//		minValue	300.0;
//		maxValue	1000000.0;
//	}

    fieldAverage1
    {
        type            fieldAverage;
        functionObjectLibs ( "libfieldFunctionObjects.so" );
        enabled         true;
        cleanRestart        true;
        // Average over the interval since the previous output: with a
        // writeInterval of a whole number of periods of the applied voltage
        // (1e-7 s is 4 periods at 40 MHz) the Mean fields are period averages
        resetOnOutput       true;
        outputControl   timeStep;
        outputControl   outputTime;
/*        outputInterval  100000;*/
        fields
        (
            Te
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            N_electron
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            Phi
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            N_Hep1
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            E
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }
        );
    }
}

