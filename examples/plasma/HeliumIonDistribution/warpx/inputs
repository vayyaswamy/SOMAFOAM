# Particle-in-cell / Monte Carlo collision run of the same case with WarpX
# (https://github.com/BLAST-WarpX/warpx; version 26.10 was used), for
# comparison with the ion distributions of ionTracker:
#
#     git clone https://github.com/BLAST-WarpX/warpx-data
#     warpx.1d inputs
#
# Case 4 of Turner et al., Phys. Plasmas 20 (2013) 013507: helium, 6.7 cm,
# 3.21e22 m^-3, 300 K, 120 V at 13.56 MHz, absorbing electrodes.
# 512 cells and 3200 steps per period as in the paper. Differences, to
# shorten the run: 20 particles per cell of variable weight (the paper: 64 of
# equal weight at the initial density), a cosine initial density near the
# steady state, and 2500 periods (15360). Three runs with different
# warpx.random_seed were averaged. With these settings the ion current at the
# electrodes agrees with the paper, but the mid-plane density and electron
# temperature do not (see doc/manual/ion_distribution_workflow.pdf): use more
# particles per cell for a reference of the bulk plasma.
#
# The ions that reach the electrodes are in diags/bound (momentum and weight
# of each); the fields at 8 phases of the period in diags/fields.

my_constants.Ngas = 3.21e22      # m^-3
my_constants.Tgas = 300          # K
my_constants.freq = 13.56e6      # Hz
my_constants.V0 = 120            # V
my_constants.L = 0.067           # m
my_constants.Mion = 6.6464731e-27
my_constants.n0 = 3.84e14
my_constants.n1 = 2.2e15
my_constants.stepsPerPeriod = 3200

max_step = 8000000
warpx.verbose = 0
warpx.const_dt = 1.0/(stepsPerPeriod*freq)
warpx.do_electrostatic = labframe
warpx.self_fields_required_precision = 1e-06
warpx.use_filter = 0
warpx.sort_intervals = 500
warpx.random_seed = 4322

amr.n_cell = 512
amr.max_grid_size = 512
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = L

boundary.field_lo = pec
boundary.field_hi = pec
boundary.particle_lo = absorbing
boundary.particle_hi = absorbing
boundary.potential_lo_z = 0.0
boundary.potential_hi_z = V0*sin(2*pi*freq*t)

algo.particle_shape = 1

particles.species_names = electrons he_ions

electrons.species_type = electron
electrons.injection_style = nuniformpercell
electrons.initialize_self_fields = 0
electrons.num_particles_per_cell_each_dim = 20
electrons.profile = parse_density_function
electrons.density_function(x,y,z) = n0 + n1*cos(pi*(z-L/2)/L)*min(1.0, min(z, L-z)/0.004)
electrons.momentum_distribution_type = maxwellian
electrons.ux_std = sqrt(kb*30000/(m_e*clight^2))
electrons.uy_std = sqrt(kb*30000/(m_e*clight^2))
electrons.uz_std = sqrt(kb*30000/(m_e*clight^2))

he_ions.species_type = helium
he_ions.charge = q_e
he_ions.injection_style = nuniformpercell
he_ions.initialize_self_fields = 0
he_ions.num_particles_per_cell_each_dim = 20
he_ions.profile = parse_density_function
he_ions.density_function(x,y,z) = n0 + n1*cos(pi*(z-L/2)/L)*min(1.0, min(z, L-z)/0.004)
he_ions.momentum_distribution_type = maxwellian
he_ions.ux_std = sqrt(kb*Tgas/(Mion*clight^2))
he_ions.uy_std = sqrt(kb*Tgas/(Mion*clight^2))
he_ions.uz_std = sqrt(kb*Tgas/(Mion*clight^2))
he_ions.save_particles_at_zlo = 1
he_ions.save_particles_at_zhi = 1

collisions.collision_names = coll_elec coll_ion

coll_ion.type = background_mcc
coll_ion.species = he_ions
coll_ion.background_density = Ngas
coll_ion.background_temperature = Tgas
coll_ion.scattering_processes = elastic elastic_back
coll_ion.elastic_cross_section = warpx-data/MCC_cross_sections/He/ion_scattering.dat
coll_ion.elastic_back_cross_section = warpx-data/MCC_cross_sections/He/ion_back_scatter.dat
coll_ion.elastic_back_scattering_angle_model = backward

coll_elec.type = background_mcc
coll_elec.species = electrons
coll_elec.background_density = Ngas
coll_elec.background_temperature = Tgas
coll_elec.scattering_processes = elastic excitation1 excitation2 ionization
coll_elec.elastic_cross_section = warpx-data/MCC_cross_sections/He/electron_scattering.dat
coll_elec.excitation1_energy = 19.82
coll_elec.excitation1_cross_section = warpx-data/MCC_cross_sections/He/excitation_1.dat
coll_elec.excitation2_energy = 20.61
coll_elec.excitation2_cross_section = warpx-data/MCC_cross_sections/He/excitation_2.dat
coll_elec.ionization_energy = 24.587
coll_elec.ionization_cross_section = warpx-data/MCC_cross_sections/He/ionization.dat
coll_elec.ionization_species = he_ions

diagnostics.diags_names = fields bound parts
fields.diag_type = Full
fields.format = openpmd
fields.openpmd_backend = h5
fields.intervals = 800000:806400:400,1600000:1606400:400,2400000:2406400:400,3200000:3206400:400,4000000:4006400:400,4800000:4806400:400,5600000:5606400:400,6400000:6406400:400,7200000:7206400:400,7897600:8000000:400
fields.fields_to_plot = rho_electrons rho_he_ions phi Ez
fields.write_species = 0

bound.diag_type = BoundaryScraping
bound.format = openpmd
bound.openpmd_backend = h5
bound.intervals = 160000

warpx.reduced_diags_names = np
np.type = ParticleNumber
np.intervals = 3200

parts.diag_type = Full
parts.format = openpmd
parts.openpmd_backend = h5
parts.intervals = 7897600:8000000:1600
parts.species = electrons
parts.fields_to_plot = none
