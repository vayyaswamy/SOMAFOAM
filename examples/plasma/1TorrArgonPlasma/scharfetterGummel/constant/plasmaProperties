FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      plasmaProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

plasmaModel  mixed<constGasThermoPhysics>;

activeSpecies 2;

backgroundGas Ar;

multiTimeStep false;

// Discretisation of the drift and diffusion fluxes of the charged species and
// of the electron energy equation (see README, "Scharfetter-Gummel fluxes"):
//   fvSchemes          the convection and Laplacian schemes of system/fvSchemes,
//                      treated as separate terms (default if the entry is absent)
//   scharfetterGummel  drift and diffusion as one flux, exact between two
//                      neighbouring cells
// It can also be set in the dictionary of a species, for that species alone.
// With either scheme the electron energy equation uses the flux of the
// electron equation through the faces.
fluxScheme      scharfetterGummel;

electron
{
	diffusionModel eTemp;
	mobilityModel eTemp;
	charge -1;
	speciesSolution true;
	collisionFrequency muBased;
	transportModel driftDiffusion;
}
Arp1
{
	diffusionModel einsteinRelation;
	//D 0.0007376;
	mobilityModel EON;
	charge 1;
	speciesSolution true;
	transportModel driftDiffusion;
}
Arm
{
	diffusionModel constant;
	D 4.7082e-3;
	speciesSolution true;
}
Ar
{
	speciesSolution false;
}

energyModel
{
    electron efullImplicit;
	ion gasTemp;
	gas none;
}

