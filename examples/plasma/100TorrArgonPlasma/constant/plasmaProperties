FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      plasmaProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

plasmaModel  mixed<constGasThermoPhysics>;

activeSpecies 2;

backgroundGas Ar;

multiTimeStep false;

electron
{
	diffusionModel eTemp;
	mobilityModel eTemp;
	charge -1;
	speciesSolution true;
	collisionFrequency muBased;
	transportModel driftDiffusion;
}
Arp1
{
	diffusionModel einsteinRelation;
	//D 0.0007376;
	mobilityModel EON;
	charge 1;
	speciesSolution true;
	transportModel driftDiffusion;
}
Arm
{
	diffusionModel constant;
	D 4.7082e-5;
	speciesSolution true;
}
Ar
{
	speciesSolution false;
}

energyModel
{
    electron efullImplicit;
	ion gasTemp;
	gas none;
}

// Acceleration of the metastable (see README, "Acceleration of slow neutral
// species"). Inactive by default. The applied voltage is 40 MHz, so the
// period is 2.5e-8 s; each 1 us block of full simulation is followed by a
// 2 us advance of Arm alone, starting after ignition at 12 us.
slowSpeciesAcceleration
{
    active          no;
    species         (Arm);
    period          2.5e-8;
    startTime       1.2e-5;
    fullCycles      40;
    averageCycles   2;
    deltaT          1e-7;
    nSteps          20;
    maxChangeFactor 2;
    tolerance       0;
}

